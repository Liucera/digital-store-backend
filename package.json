{
  "name": "digital-store-backend",
  "version": "1.0.0",
  "description": "API REST da Digital Store — projeto de Back-end da Geração Tech 4.0",
  "private": true,
  "main": "src/server.js",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:create": "node scripts/database.js create",
    "db:migrate": "node scripts/database.js migrate",
    "db:undo": "node scripts/database.js undo",
    "db:create:test": "node scripts/database.js create --test",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.15.3",
    "sequelize": "^6.37.7",
    "swagger-ui-express": "^5.0.1",
    "umzug": "^3.8.2"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.1.4"
  },
  "overrides": {
    "sequelize": { "uuid": "^11.1.1" },
    "glob": "^14.0.6",
    "minimatch": "^11.0.8"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": ["<rootDir>/tests/env.js"],
    "testTimeout": 30000,
    "collectCoverageFrom": ["src/**/*.js", "!src/server.js", "!src/database/migrations/**"]
  }
}
